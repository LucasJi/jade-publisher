{
  "name": "jade-publisher-plugin",
  "version": "2.0.0",
  "description": "This is a plugin which helps sync and publish your vault to Jade",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "Obsidian Plugin",
    "Obsidian Publish Solution",
    "Obsidian Sync Solution"
  ],
  "author": "LucasJi",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^16.11.6",
    "@types/spark-md5": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "@hocuspocus/provider": "^3.2.3",
    "diff-match-patch": "^1.0.5",
    "spark-md5": "^3.0.2",
    "yjs": "^13.6.27"
  }
}
