{
  "name": "jade-publisher-plugin",
  "version": "2.0.0",
  "description": "This is a plugin which helps sync and publish your vault to Jade",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "Obsidian Plugin",
    "Obsidian Publish Solution",
    "Obsidian Sync Solution"
  ],
  "author": "LucasJi",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^25.9.1",
    "@types/spark-md5": "^3.0.5",
    "builtin-modules": "5.2.0",
    "esbuild": "0.28.0",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.1.0",
    "diff-match-patch": "^1.0.5",
    "spark-md5": "^3.0.2",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.31"
  }
}
